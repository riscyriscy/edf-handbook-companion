[Unit]
Description=Product host firewall
Documentation=file:///etc/handbook-firewall.nft
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/nft -c -f /etc/handbook-firewall.nft
ExecStart=/usr/sbin/nft -f /etc/handbook-firewall.nft
ExecReload=/usr/sbin/nft -c -f /etc/handbook-firewall.nft
ExecReload=/usr/sbin/nft -f /etc/handbook-firewall.nft
ExecStop=-/usr/sbin/nft delete table inet handbook

[Install]
WantedBy=sysinit.target
